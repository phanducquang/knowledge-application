# Copy to /home/ubuntu/knowledge-application/shared/api.env; edit all placeholders; chmod 600.
# Trusted Bash-compatible assignments. Quote values, especially secrets.
# Do not commit the real file. Use actual PostgreSQL/RustFS service endpoints.

KNOWLEDGE_JAVA_BIN='/usr/bin/java'
# Set heap sizes only after checking RAM available alongside other VPS services.
# KNOWLEDGE_JAVA_XMS='128m'
# KNOWLEDGE_JAVA_XMX='512m'

SERVER_ADDRESS='127.0.0.1'
SERVER_PORT='8080'
SERVER_FORWARD_HEADERS_STRATEGY='framework'
SERVER_SHUTDOWN='graceful'
SPRING_LIFECYCLE_TIMEOUT_PER_SHUTDOWN_PHASE='30s'

DB_HOST='CHANGE_ME_POSTGRES_HOST'
DB_PORT='5432'
DB_NAME='knowledge_app'
DB_USERNAME='knowledge_app'
DB_PASSWORD='CHANGE_ME_RUNTIME_DB_PASSWORD'
SPRING_FLYWAY_USER='knowledge_migrator'
SPRING_FLYWAY_PASSWORD='CHANGE_ME_MIGRATION_DB_PASSWORD'

GOOGLE_CLIENT_ID='CHANGE_ME_GOOGLE_CLIENT_ID'
GOOGLE_CLIENT_SECRET='CHANGE_ME_GOOGLE_CLIENT_SECRET'
AUTH_ALLOWED_EMAIL='owner@example.com'
# Preserve the existing UUID when importing existing Knowledge data.
APP_OWNER_ID='00000000-0000-0000-0000-000000000001'
WEB_BASE_URL='https://knowledge.example.com'
SESSION_COOKIE_SECURE='true'

# Use the actual RustFS S3 endpoint and configured region, not the console URL.
OBJECT_STORAGE_ENDPOINT='https://CHANGE_ME_RUSTFS_S3_ENDPOINT'
OBJECT_STORAGE_REGION='us-east-1'
OBJECT_STORAGE_BUCKET='knowledge-images'
OBJECT_STORAGE_ACCESS_KEY='CHANGE_ME_RUSTFS_ACCESS_KEY'
OBJECT_STORAGE_SECRET_KEY='CHANGE_ME_RUSTFS_SECRET_KEY'
OBJECT_STORAGE_PATH_STYLE='true'
KNOWLEDGE_IMAGE_MAX_SIZE='10MB'
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE='12MB'

# Enable cleanup after validating the target DB/bucket and any imported data.
KNOWLEDGE_ATTACHMENT_CLEANUP_ENABLED='false'
EMBEDDING_ENABLED='false'
ASK_ENABLED='false'
AI_METADATA_ENABLED='false'
GEMINI_API_KEY=''
