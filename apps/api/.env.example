# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=knowledge_app
DB_USERNAME=knowledge_app
DB_PASSWORD=knowledge_app

# Google OAuth2/OIDC credentials (create a Web application in Google Cloud).
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Only this verified Google email can become the configured persisted owner.
AUTH_ALLOWED_EMAIL=owner@example.com
APP_OWNER_ID=00000000-0000-0000-0000-000000000001

# Minimum age of the latest revision before another autosave checkpoint is eligible.
KNOWLEDGE_REVISION_INTERVAL=PT5M

# Next.js origin used after successful or rejected login.
WEB_BASE_URL=http://localhost:3000

# Keep false on HTTP localhost; set true behind production HTTPS.
SESSION_COOKIE_SECURE=false
