# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=knowledge_app
DB_USERNAME=knowledge_app
DB_PASSWORD=knowledge_app

# Optional backend-only Gemini. Inject a real key securely, never commit it.
# Both features default off; no key required while disabled. Never NEXT_PUBLIC_*.
# Private note text/questions leave the application when enabled; Free Tier data
# handling differs from paid usage. Read docs/ASK_MY_KNOWLEDGE.md before enabling.
GEMINI_API_KEY=
EMBEDDING_ENABLED=false
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
EMBEDDING_CONNECT_TIMEOUT=PT5S
EMBEDDING_READ_TIMEOUT=PT30S
EMBEDDING_BATCH_SIZE=16
EMBEDDING_INDEXING_ENABLED=true
EMBEDDING_INDEX_INTERVAL=PT1M
EMBEDDING_INDEX_INITIAL_DELAY=PT30S
EMBEDDING_KNOWLEDGE_BATCH_SIZE=10
EMBEDDING_MAX_CHUNK_CHARS=4000
EMBEDDING_OVERLAP_CHARS=200

# Application operational ceilings, NOT promises about Gemini account limits.
# Check AI Studio for the actual project/model/tier limits whenever these change.
# One native synchronous batch is one request; tokens are conservatively estimated.
EMBEDDING_QUOTA_ENABLED=true
EMBEDDING_RPM_LIMIT=80
EMBEDDING_TPM_LIMIT=24000
EMBEDDING_RPD_LIMIT=800
EMBEDDING_BG_RPM_LIMIT=50
EMBEDDING_BG_TPM_LIMIT=18000
EMBEDDING_BG_RPD_LIMIT=650
EMBEDDING_TOKEN_ESTIMATE_CHARS_PER_TOKEN=2.5
EMBEDDING_RPD_RESET_ZONE=America/Los_Angeles

# Ask requires enabled embeddings and a current compatible index for an answer.
# Independent generation budget; shares GEMINI_API_KEY, not embedding counters.
ASK_ENABLED=false
ASK_BASE_URL=https://generativelanguage.googleapis.com
ASK_MODEL=gemini-3.5-flash-lite
ASK_CONNECT_TIMEOUT=PT5S
ASK_READ_TIMEOUT=PT45S
ASK_MAX_OUTPUT_TOKENS=1200
ASK_MAX_CONTEXT_CHARS=24000
ASK_MAX_CHUNKS=8
ASK_MAX_CHUNKS_PER_KNOWLEDGE=2
ASK_MAX_SOURCES=6
ASK_QUOTA_ENABLED=true
ASK_RPM_LIMIT=10
ASK_TPM_LIMIT=200000
ASK_RPD_LIMIT=400
ASK_TOKEN_ESTIMATE_CHARS_PER_TOKEN=2.5
ASK_RPD_RESET_ZONE=America/Los_Angeles

# Google OAuth2/OIDC credentials (create a Web application in Google Cloud).
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Only this verified Google email can become the configured persisted owner.
AUTH_ALLOWED_EMAIL=owner@example.com
APP_OWNER_ID=00000000-0000-0000-0000-000000000001

# Minimum age of the latest revision before another autosave checkpoint is eligible.
KNOWLEDGE_REVISION_INTERVAL=PT5M

# Private S3-compatible image storage. These local values match Docker Compose.
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=knowledge-images
OBJECT_STORAGE_ACCESS_KEY=knowledge_minio
OBJECT_STORAGE_SECRET_KEY=change-me-for-local-development
OBJECT_STORAGE_PATH_STYLE=true
KNOWLEDGE_IMAGE_MAX_SIZE=10MB
KNOWLEDGE_IMAGE_MAX_DIMENSION=20000
KNOWLEDGE_IMAGE_MAX_PIXELS=100000000

# Revision-aware orphan attachment cleanup. A fresh upload is protected by the
# grace period until its attachment:// UUID is persisted in Markdown.
KNOWLEDGE_ATTACHMENT_CLEANUP_ENABLED=true
KNOWLEDGE_ATTACHMENT_ORPHAN_GRACE_PERIOD=PT24H
KNOWLEDGE_ATTACHMENT_CLEANUP_INTERVAL=PT1H
KNOWLEDGE_ATTACHMENT_CLEANUP_INITIAL_DELAY=PT5M
KNOWLEDGE_ATTACHMENT_CLEANUP_BATCH_SIZE=100

# Next.js origin used after successful or rejected login.
WEB_BASE_URL=http://localhost:3000

# Keep false on HTTP localhost; set true behind production HTTPS.
SESSION_COOKIE_SECURE=false
